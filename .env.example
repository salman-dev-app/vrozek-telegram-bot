# VROZEK AI — environment configuration
# Copy to `.env` for scripts/setup.js, or use `npx wrangler secret put <NAME>` for the Worker.

# REQUIRED
TELEGRAM_BOT_TOKEN=123456:ABC-YourBotTokenFromBotFather

# REQUIRED for AI replies (or set later in Dashboard > Settings > gemini_api_key)
GEMINI_API_KEY=your_gemini_api_key

# Optional — model override (default: gemini-3.5-flash)
GEMINI_MODEL=gemini-3.5-flash

# Comma-separated Telegram user IDs promoted to Super Admin on first run
ADMIN_IDS=111111111

# Web Admin Dashboard credentials (basic auth)
DASHBOARD_USERNAME=salman
DASHBOARD_PASSWORD=change-me-strong-password

# Optional: secret token Telegram sends with each webhook call (X-Telegram-Bot-Api-Secret-Token)
WEBHOOK_SECRET=change-me-random-string
